<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Metadata -->
    <AssemblyTitle>Xquik C# SDK</AssemblyTitle>
    <AssemblyName>XTwitterScraper</AssemblyName>
    <VersionPrefix>0.6.3</VersionPrefix>
    <Description>X API &amp; Twitter API SDK for C# &amp; .NET. Scrape Twitter search, profiles &amp; followers as a Twitter scraper &amp; tweet scraper. Not affiliated with X Corp.</Description>
    <OutputType>Library</OutputType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XTwitterScraper.Tests"/>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    <None Include="icon.png" Pack="true" PackagePath="\"/>
    <PackageReference Include="System.Text.Json" Version="10.0.13"/>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" Version="10.0.13"/>
    <!-- NETStandard.Library asks for 1.1.0, which predates the MIT license. The package holds the list of platforms and no code. -->
    <PackageReference Include="Microsoft.NETCore.Platforms" Version="7.0.4" PrivateAssets="All"/>
  </ItemGroup>
</Project>
