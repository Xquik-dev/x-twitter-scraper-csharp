#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

readonly repository="Xquik-dev/x-twitter-scraper-csharp"
readonly package_id="XTwitterScraper"
readonly project_file="src/XTwitterScraper/XTwitterScraper.csproj"
readonly nuget_source="https://api.nuget.org/v3/index.json"
readonly version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'

dry_run=false
for argument in "$@"; do
  case "$argument" in
    --dry-run) dry_run=true ;;
    *)
      echo "Unknown option $argument. Run bin/release-local or bin/release-local --dry-run." >&2
      exit 2
      ;;
  esac
done

step()
{
  echo "==> $1"
}

refuse()
{
  echo "$1" >&2
  exit 1
}

if [[ "$dry_run" == false && -z "${NUGET_KEYCHAIN_SERVICE:-}" ]]; then
  refuse "NUGET_KEYCHAIN_SERVICE is unset or empty. Set it to the Keychain service that holds the NuGet API key, then run bin/release-local again."
fi

workspace="$(mktemp -d "${TMPDIR:-/tmp}/xquik-csharp-release.XXXXXX")"
trap 'rm -rf -- "${workspace:?}"' EXIT

lowercase()
{
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

nuget_has_version()
{
  local index
  index="$(
    curl --fail --silent --show-error --location \
      --proto '=https' --tlsv1.2 --max-time 30 \
      "https://api.nuget.org/v3-flatcontainer/$(lowercase "$package_id")/index.json"
  )" || refuse "NuGet.org did not answer. Check the network, then rerun."
  jq -e --arg version "$(lowercase "$version")" \
    '.versions | index($version) != null' <<<"$index" >/dev/null
}

list_package()
{
  local name files
  name="$(basename -- "$1")"
  files="$(unzip -Z1 "$1" | LC_ALL=C sort)"
  echo "$name holds $(wc -l <<<"$files" | tr -d '[:space:]') files."
  echo "$files"
}

step "Checking required tools"
required_tools=(curl dotnet gh git jq node unzip)
if [[ "$dry_run" == false ]]; then
  required_tools+=(security)
fi
for tool in "${required_tools[@]}"; do
  command -v "$tool" >/dev/null 2>&1 || refuse "$tool is not installed. Install it, then rerun."
done

step "Checking that the working tree is clean"
tree_changes="$(git status --porcelain)"
[[ -z "$tree_changes" ]] ||
  refuse "The working tree has changes. Commit or remove them, then rerun."

step "Checking that main is checked out"
[[ "$(git symbolic-ref --quiet --short HEAD || true)" == "main" ]] ||
  refuse "The current branch is not main. Switch to main, then rerun."

step "Checking that main matches origin/main"
git fetch --quiet origin main
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] ||
  refuse "main differs from origin/main. Pull or push main, then rerun."

step "Reading the version from $project_file"
version="$(sed -n 's:.*<VersionPrefix>\(.*\)</VersionPrefix>.*:\1:p' "$project_file")"
[[ "$version" =~ $version_pattern ]] ||
  refuse "$project_file has no valid VersionPrefix. Fix it, then rerun."
manifest_version="$(jq -er '."."' .release-please-manifest.json)" ||
  refuse ".release-please-manifest.json has no version. Fix it, then rerun."
[[ "$manifest_version" == "$version" ]] ||
  refuse "The manifest says $manifest_version but $project_file says $version. Align them, then rerun."
tag="v$version"

step "Checking that tag $tag does not exist yet"
remote_tag="$(git ls-remote --tags origin "refs/tags/$tag")"
[[ -z "$remote_tag" ]] || refuse "Tag $tag already exists on origin. Bump the version, then rerun."
if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then
  refuse "Tag $tag exists only in this clone. Delete it with git tag -d $tag, then rerun."
fi

step "Reading the release notes for $version from CHANGELOG.md"
notes_file="$workspace/notes.md"
awk -v version="$version" '
  /^## / { if (found) exit; found = ($2 == version); next }
  found
' CHANGELOG.md >"$notes_file"
grep -q '[^[:space:]]' "$notes_file" ||
  refuse "CHANGELOG.md has no section for $version. Add one, then rerun."

step "Checking GitHub CLI access"
gh auth status >/dev/null 2>&1 ||
  refuse "The GitHub CLI is not signed in. Run gh auth login, then rerun."

step "Checking NuGet.org for $package_id $version"
if nuget_has_version; then
  already_published=true
  echo "NuGet.org already has $package_id $version. A release skips the upload."
else
  already_published=false
  echo "NuGet.org does not have $package_id $version yet. A release uploads it."
  if [[ "$dry_run" == false ]]; then
    step "Checking the Keychain for the NuGet API key"
    security find-generic-password -s "$NUGET_KEYCHAIN_SERVICE" >/dev/null 2>&1 ||
      refuse "The Keychain has no item under the service that NUGET_KEYCHAIN_SERVICE names. Add the NuGet API key with security add-generic-password -s \"\$NUGET_KEYCHAIN_SERVICE\" -a \"\$USER\" -w, then rerun."
  fi
fi

step "Running bin/check-local"
bin/check-local

step "Auditing dependencies for known vulnerabilities"
./scripts/audit

step "Building $package_id $version"
package_dir="$workspace/packages"
package_file="$package_dir/$package_id.$version.nupkg"
symbols_file="$package_dir/$package_id.$version.symbols.nupkg"
./scripts/build-package "$package_dir" "$version"
[[ -f "$package_file" && -f "$symbols_file" ]] ||
  refuse "The build did not produce the $version packages. Check the build output, then rerun."

step "Reading the listing from $package_id.$version.nupkg"
unzip -p "$package_file" "$package_id.nuspec" >"$workspace/package.nuspec" ||
  refuse "The package holds no $package_id.nuspec. Check the build output, then rerun."
node scripts/package-listing.mjs "$workspace/package.nuspec" "$package_id" "$version"

if [[ "$dry_run" == true ]]; then
  step "Listing the files that $package_id $version would publish"
  list_package "$package_file"
  list_package "$symbols_file"
  echo "Dry run finished. Nothing was published, tagged or released."
  exit 0
fi

if [[ "$already_published" == true ]]; then
  step "Skipping the NuGet upload because NuGet.org already has $package_id $version"
else
  step "Uploading $package_id $version to NuGet.org"
  api_key="$(security find-generic-password -s "$NUGET_KEYCHAIN_SERVICE" -w 2>/dev/null)" ||
    refuse "The Keychain did not return the item that NUGET_KEYCHAIN_SERVICE names. Unlock the Keychain, then rerun."
  # The key goes through NUGET_API_KEY, which dotnet nuget push reads. An --api-key argument would
  # show in the process list.
  # https://learn.microsoft.com/en-us/nuget/reference/cli-reference/cli-ref-environment-variables
  NUGET_API_KEY="$api_key" dotnet nuget push "$package_file" \
    --skip-duplicate \
    --source "$nuget_source"
  unset api_key
fi

step "Creating and pushing tag $tag"
git tag -a "$tag" -m "$package_id $version"
git push origin "refs/tags/$tag"

if [[ "$version" == *-* ]]; then
  release_flags=(--prerelease --latest=false)
else
  release_flags=(--latest)
fi

step "Looking for a draft GitHub release for $tag"
draft_release="$(
  gh release list --repo "$repository" --limit 100 --json tagName,isDraft \
    --jq ".[] | select(.isDraft and .tagName == \"$tag\") | .tagName"
)"
if [[ -n "$draft_release" ]]; then
  step "Publishing the existing draft GitHub release $tag"
  gh release upload "$tag" "$package_file" --repo "$repository" --clobber
  gh release edit "$tag" \
    --repo "$repository" \
    --title "$tag" \
    --notes-file "$notes_file" \
    --draft=false \
    --verify-tag \
    "${release_flags[@]}"
else
  step "Creating GitHub release $tag"
  gh release create "$tag" "$package_file" \
    --repo "$repository" \
    --title "$tag" \
    --notes-file "$notes_file" \
    --verify-tag \
    "${release_flags[@]}"
fi

echo "Released $package_id $version."
