#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

codeql_workspace="$(mktemp -d "${TMPDIR:-/tmp}/xquik-csharp-codeql.XXXXXX")"
trap 'rm -rf -- "$codeql_workspace"' EXIT
codeql_workspace="$(cd -- "$codeql_workspace" && pwd -P)"

echo "==> Copying the source files for CodeQL"
mkdir -p -- "$codeql_workspace/source"
tar -cf - -T <(git ls-files --cached --others --exclude-standard) |
  tar -xf - -C "$codeql_workspace/source"

echo "==> Restoring the locked packages of the copy"
(cd -- "$codeql_workspace/source" && dotnet restore --locked-mode)

echo "==> Running the CodeQL security-extended and comment queries"
DOTNET_ROLL_FORWARD=Major codeql database create "$codeql_workspace/database" \
  --language=csharp \
  --build-mode=manual \
  --command="dotnet build XTwitterScraper.sln --no-restore -p:UseSharedCompilation=false" \
  --source-root="$codeql_workspace/source" \
  --threads=0 \
  --quiet
codeql pack install codeql/no-code-comments
codeql database analyze "$codeql_workspace/database" \
  codeql/csharp-queries:codeql-suites/csharp-security-extended.qls \
  codeql/no-code-comments \
  --download \
  --format=sarif-latest \
  --output="$codeql_workspace/results.sarif" \
  --threads=0 \
  --quiet

node - "$codeql_workspace/results.sarif" "$codeql_workspace/source/" <<'EOF'
const fs = require("node:fs");

const diagnostics = ["cs/diagnostics/extraction-errors", "cs/compilation-error", "cs/extraction-error"];
const [report, copy] = process.argv.slice(2);
const runs = JSON.parse(fs.readFileSync(report, "utf8")).runs;
const fail = (message) => {
  console.error(message);
  process.exit(1);
};

const ran = runs.flatMap((run) => run.tool?.["driver"]?.notifications ?? []).map((query) => query.id);
const missing = diagnostics.filter((id) => !ran.includes(id));
if (missing.length > 0) {
  fail(`The CodeQL scan lacks ${missing.join(" and ")}, so it cannot show that it read every file. Make the suite in scripts/codeql run each missing diagnostic query.`);
}
const unread = runs
  .flatMap((run) => run.invocations ?? [])
  .flatMap((invocation) => invocation.toolExecutionNotifications ?? [])
  .filter((notification) => diagnostics.includes(notification.descriptor?.id))
  .map((notification) => {
    const where = notification.locations?.[0]?.physicalLocation;
    const place = where ? `${where.artifactLocation?.uri} at line ${where.region?.startLine}. ` : "";
    return `${place}${(notification.message?.text ?? "").split("\n")[0].replaceAll(copy, "")}`;
  });
if (unread.length > 0) {
  for (const line of new Set(unread)) console.error(line);
  fail("CodeQL could not read the C# code above, so the scan is incomplete. Fix that code so it compiles, then rerun.");
}

const results = runs.flatMap((run) => run.results ?? []);
for (const result of results) {
  const where = result.locations?.[0]?.physicalLocation;
  console.log(`${result.ruleId} at ${where?.artifactLocation?.uri}:${where?.region?.startLine}. ${result.message?.text}`);
}
if (results.length > 0) fail("CodeQL found the results above. Fix each one.");
console.log("CodeQL found no results.");
EOF
