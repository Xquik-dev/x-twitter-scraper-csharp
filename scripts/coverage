#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

if [[ "$#" -lt 1 || "$#" -gt 2 || ! -f "$1" ]]; then
  echo "Usage: ./scripts/coverage <parent-coverage.json> [output-directory]" >&2
  exit 2
fi

baseline="$(cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")"
cd -- "$(dirname -- "$0")/.."
output_directory="${2:-.artifacts/coverage}"
mkdir -p -- "$output_directory"
output_directory="$(cd -- "$output_directory" && pwd)"
coverage_workspace="$(mktemp -d "$output_directory/run.XXXXXX")"

echo "==> Validating the parent coverage report"
(
  cd tools/coverage
  go run . summary "$baseline"
)

echo "==> Building the .NET 8 test executable"
dotnet build src/XTwitterScraper.Tests/XTwitterScraper.Tests.csproj \
  --framework net8.0 --no-restore

echo "==> Measuring every SDK type, including generated code & properties"
dotnet tool run coverlet \
  src/XTwitterScraper.Tests/bin/Debug/net8.0/XTwitterScraper.Tests.dll \
  --target dotnet \
  --targetargs "test --project src/XTwitterScraper.Tests/XTwitterScraper.Tests.csproj --framework net8.0 --no-build --no-restore --fail-skips on --results-directory \"$coverage_workspace\" --report-xunit-trx --report-xunit-trx-filename tests.trx" \
  --include '[XTwitterScraper]*' \
  --exclude-assemblies-without-sources None \
  --format json --format cobertura --format opencover \
  --output "$coverage_workspace/" \
  --diag "$coverage_workspace/instrumentation.log"

echo "==> Comparing native line, branch & method counts"
(
  cd tools/coverage
  go run . summary "$coverage_workspace/coverage.json" > "$coverage_workspace/summary.json"
  go run . compare "$baseline" "$coverage_workspace/coverage.json" > "$coverage_workspace/comparison.json"
)
echo "Coverage evidence: $coverage_workspace"
